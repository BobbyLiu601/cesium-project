{
  "name": "cesium-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "run-s type-check build-only check:bundle",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --configLoader native",
    "test": "vitest run --configLoader native",
    "test:unit": "vitest run --configLoader native",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build-only": "vite build --configLoader native",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache --cache-location .cache/eslintcache",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint lint:check:template",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint . --cache --cache-location .cache/eslintcache",
    "lint:check:template": "node scripts/check-template-content.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:staged": "node scripts/check-secrets.mjs --staged",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "check:template": "node scripts/check-template-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:models": "node scripts/generate-project-models.mjs",
    "prepare": "simple-git-hooks",
    "verify": "run-s lint:check format:check type-check test test:e2e check:secrets build-only check:bundle",
    "verify:pages": "run-s build:pages check:pages"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-git-branch.mjs pre-commit && node scripts/check-secrets.mjs --staged",
    "pre-push": "node scripts/check-git-branch.mjs pre-push"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "cesium": "^1.147.0",
    "element-plus": "^2.14.7",
    "hls.js": "^1.7.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "secretlint": "13.1.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "24.22.0"
  }
}
